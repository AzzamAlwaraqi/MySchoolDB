  <DataSets>
    <DataSet Name="SchoolHonorList">
      <Query>
        <DataSourceName>SchoolDBDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ClassLevel">
            <Value>=Parameters!ClassLevel.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    Student_id,
    First_Name,
    Last_Name,
    Class_Level,
    class_Letter,
    student_Avg_Grade,
    Student_rank
FROM Student_First_Three_for_each_class
WHERE Class_Level = @ClassLevel
ORDER BY class_Letter, Student_rank;</CommandText>
      </Query>
      <Fields>
        <Field Name="Student_id">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Student_id</DataField>
        </Field>
        <Field Name="First_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>First_Name</DataField>
        </Field>
        <Field Name="Last_Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Last_Name</DataField>
        </Field>
        <Field Name="Class_Level">
          <rd:TypeName>System.Byte</rd:TypeName>
          <DataField>Class_Level</DataField>
        </Field>
        <Field Name="class_Letter">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>class_Letter</DataField>
        </Field>
        <Field Name="student_Avg_Grade">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>student_Avg_Grade</DataField>
        </Field>
        <Field Name="Student_rank">
          <rd:TypeName>System.Int64</rd:TypeName>
          <DataField>Student_rank</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
